#!/usr/bin/env python3
import argparse
import colorsys
import hashlib
import json
import math
import os
import subprocess
import sys
from PIL import Image

HOME = os.path.expanduser("~")
THUMBS_DIR = os.path.join(HOME, ".cache/caelestia/live_thumbs")
PLAYBACK_DIR = os.path.join(HOME, ".cache/caelestia/live_cache")
JSON_CACHE = os.path.join(HOME, ".cache/caelestia/wallpaper_properties.json")
SETTINGS_PATH = os.path.join(HOME, ".config/caelestia/Wallpaper_Settings.json")
VAAPI_DEVICE = "/dev/dri/renderD128"

HW_DECODE_CODECS = {"h264", "hevc", "vp9", "av1"}
VIDEO_EXTENSIONS = (".mp4", ".mkv", ".webm", ".avi", ".mov")

TARGET_CENTERS = {
    "red": 0.0,
    "orange": 28.0,
    "yellow": 55.0,
    "green": 125.0,
    "blue": 210.0,
    "purple": 280.0,
    "pink": 330.0,
}

BANDWIDTH = 26.0


def get_pictures_dir():
    try:
        res = subprocess.run(
            ["xdg-user-dir", "PICTURES"],
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
        path = res.stdout.strip()
        if path and os.path.exists(path):
            return path
    except Exception:
        pass
    for fallback in (
        os.path.join(HOME, "Pictures"),
        os.path.join(HOME, "Imágenes"),
        os.path.join(HOME, "Imagenes"),
    ):
        if os.path.exists(fallback):
            return fallback
    return os.path.join(HOME, "Pictures")


def load_max_fps() -> int:
    try:
        with open(SETTINGS_PATH, encoding="utf-8") as f:
            data = json.load(f)
        v = data.get("maxFps", 30)
        return int(v) if v is not None else 30
    except (OSError, json.JSONDecodeError, TypeError, ValueError):
        return 30


def hue_distance(h1, h2):
    diff = abs(h1 - h2) % 360.0
    return min(diff, 360.0 - diff)


def get_ffprobe_info(filepath):
    try:
        cmd = [
            "ffprobe",
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            "stream=width,height,r_frame_rate,codec_name",
            "-of",
            "json",
            filepath,
        ]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        data = json.loads(res.stdout)
        stream = data["streams"][0]
        w, h = stream["width"], stream["height"]
        num, den = map(int, stream["r_frame_rate"].split("/"))
        fps = round(num / den) if den > 0 else None
        codec = (stream.get("codec_name") or "").lower()
        return w, h, fps, codec
    except Exception:
        return None, None, None, None


def get_image_info(filepath):
    try:
        with Image.open(filepath) as img:
            return img.size[0], img.size[1]
    except Exception:
        return None, None


def classify_colors_high_precision(img_path):
    try:
        with Image.open(img_path) as img:
            img = img.convert("RGB")
            img_small = img.resize((96, 96), Image.Resampling.LANCZOS)
            pixels = list(
                img_small.get_flattened_data()
                if hasattr(img_small, "get_flattened_data")
                else img_small.getdata()
            )

            total_pixels = len(pixels)
            dark_count = 0
            light_count = 0
            grey_count = 0
            vibrant_count = 0
            total_sat = 0.0
            total_val = 0.0

            for r, g, b in pixels:
                h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
                total_sat += s
                total_val += v
                if v < 0.25:
                    dark_count += 1
                elif v > 0.78 and s < 0.22:
                    light_count += 1
                if s < 0.18:
                    grey_count += 1
                if s > 0.40 and v > 0.35:
                    vibrant_count += 1

            avg_sat = total_sat / total_pixels
            avg_val = total_val / total_pixels
            dark_ratio = dark_count / total_pixels
            light_ratio = light_count / total_pixels
            grey_ratio = grey_count / total_pixels
            vibrant_ratio = vibrant_count / total_pixels

            is_strictly_white = (avg_sat < 0.22 and avg_val > 0.65) or (
                vibrant_ratio < 0.06 and light_ratio > 0.40
            )
            is_strictly_dark_grey = (avg_sat < 0.21 and avg_val < 0.50) or (
                vibrant_ratio < 0.06
                and (dark_ratio > 0.45 or (grey_ratio > 0.55 and avg_val < 0.50))
            )

            quantized = img_small.quantize(colors=24, method=Image.Quantize.MEDIANCUT)
            palette = quantized.getpalette()[:72]
            counts = quantized.getcolors()

            if not counts:
                return ("white", ["white", "grey"]) if is_strictly_white else ("black", ["black", "grey"])

            scores = {k: 0.0 for k in TARGET_CENTERS}

            for count, idx in counts:
                r = palette[idx * 3]
                g = palette[idx * 3 + 1]
                b = palette[idx * 3 + 2]

                pixel_weight = count / total_pixels
                h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
                h_deg = h * 360.0

                if s >= 0.16 and (v >= 0.12 or s >= 0.45):
                    vibrancy = (s**1.3) * (v**0.7)
                    for c_name, c_hue in TARGET_CENTERS.items():
                        dist = hue_distance(h_deg, c_hue)
                        match = math.exp(-0.5 * (dist / BANDWIDTH) ** 2)
                        scores[c_name] += pixel_weight * vibrancy * match

            max_c = max(scores, key=scores.get)
            max_score = scores[max_c]

            if is_strictly_white and max_score < 0.05:
                return "white", ["white", "grey"]

            if is_strictly_dark_grey and max_score < 0.05:
                return "black", ["black", "grey"]

            matched = [max_c]
            for c_name, score in scores.items():
                if c_name != max_c and score >= max_score * 0.35 and score > 0.02:
                    matched.append(c_name)

            if is_strictly_white and max_score < 0.08:
                if "white" not in matched:
                    matched.append("white")
                if "grey" not in matched:
                    matched.append("grey")

            if is_strictly_dark_grey and max_score < 0.08:
                if "black" not in matched:
                    matched.append("black")
                if "grey" not in matched:
                    matched.append("grey")

            if light_ratio > 0.35 and "white" not in matched and (avg_sat < 0.35 or vibrant_ratio < 0.15):
                matched.append("white")

            if dark_ratio > 0.35 and "black" not in matched and (avg_sat < 0.35 or vibrant_ratio < 0.15):
                matched.append("black")

            if max_score >= 0.03:
                return max_c, matched
            if is_strictly_white:
                return "white", matched
            return "black", matched
    except Exception:
        return "black", ["black", "grey"]


def should_refresh_cache(source_path, cache_path):
    if not os.path.exists(source_path):
        return False
    if not os.path.exists(cache_path):
        return True
    try:
        return os.path.getmtime(source_path) > os.path.getmtime(cache_path)
    except OSError:
        return True


def target_fps_limit(max_fps: int, source_fps: int | None) -> int:
    if max_fps == 0:
        return min(source_fps or 60, 60)
    return max_fps


def needs_transcode(codec: str | None, source_fps: int | None, height: int | None, limit_fps: int) -> bool:
    if codec not in HW_DECODE_CODECS:
        return True
    if source_fps and source_fps > limit_fps:
        return True
    if height and height > 1080:
        return True
    return False


def playback_cache_path(filepath: str, limit_fps: int) -> str:
    digest = hashlib.sha1(os.path.abspath(filepath).encode()).hexdigest()
    return os.path.join(PLAYBACK_DIR, f"{digest}_{limit_fps}.mp4")


def output_is_valid(path: str) -> bool:
    if not os.path.exists(path) or os.path.getsize(path) <= 0:
        return False
    try:
        res = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-select_streams",
                "v:0",
                "-show_entries",
                "stream=codec_name",
                "-of",
                "default=nw=1:nokey=1",
                path,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        return res.returncode == 0 and res.stdout.strip() != ""
    except Exception:
        return False


def transcode_video(src: str, dst: str, limit_fps: int) -> bool:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.part"
    if os.path.exists(tmp):
        try:
            os.remove(tmp)
        except OSError:
            pass

    vf_vaapi = f"fps={limit_fps},scale=-2:'min(1080,ih)',format=nv12,hwupload"
    vaapi_cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error",
        "-y",
        "-vaapi_device",
        VAAPI_DEVICE,
        "-i",
        src,
        "-an",
        "-vf",
        vf_vaapi,
        "-c:v",
        "h264_vaapi",
        "-qp",
        "24",
        "-movflags",
        "+faststart",
        tmp,
    ]
    if subprocess.run(vaapi_cmd, check=False).returncode == 0 and output_is_valid(tmp):
        os.replace(tmp, dst)
        return True

    if os.path.exists(tmp):
        try:
            os.remove(tmp)
        except OSError:
            pass

    vf_cpu = f"fps={limit_fps},scale=-2:'min(1080,ih)'"
    cpu_cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error",
        "-y",
        "-i",
        src,
        "-an",
        "-vf",
        vf_cpu,
        "-c:v",
        "libx264",
        "-preset",
        "veryfast",
        "-crf",
        "23",
        "-pix_fmt",
        "yuv420p",
        "-movflags",
        "+faststart",
        tmp,
    ]
    if subprocess.run(cpu_cmd, check=False).returncode == 0 and output_is_valid(tmp):
        os.replace(tmp, dst)
        return True

    if os.path.exists(tmp):
        try:
            os.remove(tmp)
        except OSError:
            pass
    return False


def ensure_playback_cache(filepath: str, max_fps: int) -> str:
    w, h, fps, codec = get_ffprobe_info(filepath)
    limit_fps = target_fps_limit(max_fps, fps)
    cache_path = playback_cache_path(filepath, limit_fps)

    if not needs_transcode(codec, fps, h, limit_fps):
        return os.path.abspath(filepath)

    if not should_refresh_cache(filepath, cache_path):
        return cache_path

    print(f"Transcoding playback cache for: {os.path.basename(filepath)}")
    if transcode_video(filepath, cache_path, limit_fps):
        return cache_path
    return os.path.abspath(filepath)


def load_properties() -> dict:
    try:
        with open(JSON_CACHE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def save_properties(properties: dict) -> None:
    os.makedirs(os.path.dirname(JSON_CACHE), exist_ok=True)
    with open(JSON_CACHE, "w", encoding="utf-8") as f:
        json.dump(properties, f, indent=2)


def process_file(filepath, is_video, properties, max_fps):
    ext = filepath.split(".")[-1].upper()
    info_str = ""
    playback = None

    if is_video:
        w, h, fps, _codec = get_ffprobe_info(filepath)
        if w and h:
            info_str = f"{w}x{h}, {ext}, {fps} FPS" if fps else f"{w}x{h}, {ext}"
        else:
            info_str = f"{ext}"

        thumb_path = os.path.join(THUMBS_DIR, f"{os.path.basename(filepath)}.jpg")
        if should_refresh_cache(filepath, thumb_path):
            print(f"Generating thumbnail for: {os.path.basename(filepath)}")
            subprocess.run(
                [
                    "ffmpeg",
                    "-hide_banner",
                    "-loglevel",
                    "error",
                    "-y",
                    "-i",
                    filepath,
                    "-frames:v",
                    "1",
                    "-vf",
                    "scale=384:-1:flags=lanczos",
                    "-q:v",
                    "2",
                    thumb_path,
                ],
                check=False,
            )

        playback = ensure_playback_cache(filepath, max_fps)
        analyze_path = thumb_path if os.path.exists(thumb_path) else None
    else:
        w, h = get_image_info(filepath)
        if w and h:
            info_str = f"{w}x{h}, {ext}"
        else:
            info_str = f"{ext}"
        analyze_path = filepath

    primary_color, colors = ("grey", ["grey"])
    if analyze_path and os.path.exists(analyze_path):
        primary_color, colors = classify_colors_high_precision(analyze_path)

    entry = {
        "info": info_str,
        "color": primary_color,
        "colors": colors,
    }
    if is_video and playback:
        entry["playback"] = playback
    properties[filepath] = entry


def parse_args():
    pictures = get_pictures_dir()
    parser = argparse.ArgumentParser(description="Update Caelestia live wallpaper thumbnails and playback cache")
    parser.add_argument(
        "walls_dir",
        nargs="?",
        default=os.path.join(pictures, "Wallpapers"),
        help="Static wallpapers directory",
    )
    parser.add_argument(
        "live_dir",
        nargs="?",
        default=os.path.join(pictures, "Live-Wallpapers"),
        help="Live wallpapers directory",
    )
    parser.add_argument(
        "--file",
        dest="single_file",
        default=None,
        help="Process a single video file and merge into wallpaper_properties.json",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    max_fps = load_max_fps()
    os.makedirs(THUMBS_DIR, exist_ok=True)
    os.makedirs(PLAYBACK_DIR, exist_ok=True)

    properties = load_properties() if args.single_file else {}

    if args.single_file:
        filepath = os.path.abspath(args.single_file)
        if not filepath.lower().endswith(VIDEO_EXTENSIONS):
            print(f"Not a video file: {filepath}", file=sys.stderr)
            sys.exit(1)
        if not os.path.isfile(filepath):
            print(f"File not found: {filepath}", file=sys.stderr)
            sys.exit(1)
        process_file(filepath, True, properties, max_fps)
        save_properties(properties)
        print(f"Done! Updated playback cache for {os.path.basename(filepath)}.")
        return

    print("Searching for wallpapers and analyzing high-precision colors...")
    for base_dir, is_vid, exts in [
        (args.live_dir, True, VIDEO_EXTENSIONS),
        (args.walls_dir, False, (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif")),
    ]:
        if os.path.exists(base_dir):
            for root, _, files in os.walk(base_dir):
                for f in files:
                    if f.lower().endswith(exts):
                        process_file(os.path.join(root, f), is_vid, properties, max_fps)

    save_properties(properties)
    print(f"Done! Processed {len(properties)} wallpapers with high-precision dark/grey detection.")


if __name__ == "__main__":
    main()
