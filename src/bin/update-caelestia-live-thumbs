#!/usr/bin/env python3
import colorsys
import json
import math
import os
import subprocess
import sys

from PIL import Image

HOME = os.path.expanduser("~")
CACHE_DIR = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
THUMBS_DIR = os.path.join(CACHE_DIR, "caelestia", "live_thumbs")
JSON_CACHE = os.path.join(CACHE_DIR, "caelestia", "wallpaper_properties.json")


def get_pictures_dir():
    try:
        res = subprocess.run(
            ["xdg-user-dir", "PICTURES"], capture_output=True, text=True, check=False
        )
        path = res.stdout.strip()
        if path and os.path.exists(path):
            return path
    except (OSError, subprocess.SubprocessError):
        pass
    for fallback in [
        os.path.join(HOME, "Pictures"),
        os.path.join(HOME, "Imágenes"),
        os.path.join(HOME, "Imagenes"),
    ]:
        if os.path.exists(fallback):
            return fallback
    return os.path.join(HOME, "Pictures")


PICTURES_DIR = get_pictures_dir()

INCLUDE_STATIC = "--include-static" in sys.argv
dir_args = [a for a in sys.argv[1:] if not a.startswith("--")]

if len(dir_args) == 0:
    LIVE_WALLPAPERS_DIR = os.path.join(PICTURES_DIR, "Live-Wallpapers")
    WALLPAPERS_DIR = os.path.join(PICTURES_DIR, "Wallpapers")
elif len(dir_args) == 1:
    if "live" in dir_args[0].lower():
        LIVE_WALLPAPERS_DIR = dir_args[0]
        WALLPAPERS_DIR = os.path.join(PICTURES_DIR, "Wallpapers")
    else:
        WALLPAPERS_DIR = dir_args[0]
        LIVE_WALLPAPERS_DIR = os.path.join(PICTURES_DIR, "Live-Wallpapers")
else:
    if "live" in dir_args[0].lower():
        LIVE_WALLPAPERS_DIR, WALLPAPERS_DIR = dir_args[0], dir_args[1]
    else:
        WALLPAPERS_DIR, LIVE_WALLPAPERS_DIR = dir_args[0], dir_args[1]

os.makedirs(THUMBS_DIR, exist_ok=True)
properties = {}
if os.path.exists(JSON_CACHE):
    try:
        with open(JSON_CACHE, "r") as f:
            properties = json.load(f)
    except (OSError, json.JSONDecodeError):
        properties = {}

TARGET_CENTERS = {
    "red": 0.0,
    "orange": 28.0,
    "yellow": 55.0,
    "green": 125.0,
    "blue": 210.0,
    "purple": 280.0,
    "pink": 330.0,
}

BANDWIDTH = 26.0


def hue_distance(h1, h2):
    diff = abs(h1 - h2) % 360.0
    return min(diff, 360.0 - diff)


def get_ffprobe_info(filepath):
    try:
        cmd = [
            "ffprobe",
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            "stream=width,height,r_frame_rate",
            "-of",
            "json",
            filepath,
        ]
        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
        data = json.loads(res.stdout)
        stream = data["streams"][0]
        w, h = stream["width"], stream["height"]
        num, den = map(int, stream["r_frame_rate"].split("/"))
        fps = round(num / den) if den > 0 else None
        return w, h, fps
    except (
        OSError,
        subprocess.SubprocessError,
        json.JSONDecodeError,
        KeyError,
        IndexError,
        ValueError,
        ZeroDivisionError,
    ):
        return None, None, None


def get_image_info(filepath):
    try:
        with Image.open(filepath) as img:
            return img.size[0], img.size[1]
    except (OSError, ValueError):
        return None, None


def classify_colors_high_precision(img_path):
    try:
        with Image.open(img_path) as img:
            img = img.convert("RGB")
            img_small = img.resize((32, 32), Image.Resampling.BILINEAR)
            raw_bytes = img_small.tobytes()
            pixels: list[tuple[int, int, int]] = [
                (raw_bytes[i], raw_bytes[i + 1], raw_bytes[i + 2])
                for i in range(0, len(raw_bytes), 3)
            ]

            total_pixels = len(pixels)
            dark_count = 0
            light_count = 0
            grey_count = 0
            vibrant_count = 0
            total_sat = 0.0
            total_val = 0.0

            for r, g, b in pixels:
                h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
                total_sat += s
                total_val += v
                if v < 0.25:
                    dark_count += 1
                elif v > 0.78 and s < 0.22:
                    light_count += 1
                if s < 0.18:
                    grey_count += 1
                if s > 0.40 and v > 0.35:
                    vibrant_count += 1

            avg_sat = total_sat / total_pixels
            avg_val = total_val / total_pixels
            dark_ratio = dark_count / total_pixels
            light_ratio = light_count / total_pixels
            grey_ratio = grey_count / total_pixels
            vibrant_ratio = vibrant_count / total_pixels

            is_strictly_white = (avg_sat < 0.22 and avg_val > 0.65) or (
                vibrant_ratio < 0.06 and light_ratio > 0.40
            )
            is_strictly_dark_grey = (avg_sat < 0.21 and avg_val < 0.50) or (
                vibrant_ratio < 0.06
                and (dark_ratio > 0.45 or (grey_ratio > 0.55 and avg_val < 0.50))
            )

            quantized = img_small.quantize(colors=16, method=Image.Quantize.FASTOCTREE)
            palette = quantized.getpalette()
            if not palette:
                return (
                    ("white", ["white", "grey"])
                    if is_strictly_white
                    else ("black", ["black", "grey"])
                )
            palette_slice = palette[:72]
            counts = quantized.getcolors()

            if not counts:
                return (
                    ("white", ["white", "grey"])
                    if is_strictly_white
                    else ("black", ["black", "grey"])
                )

            scores = {k: 0.0 for k in TARGET_CENTERS}

            for count, color_val in counts:
                color_idx = int(color_val) if isinstance(color_val, (int, float)) else 0
                r = palette_slice[color_idx * 3]
                g = palette_slice[color_idx * 3 + 1]
                b = palette_slice[color_idx * 3 + 2]

                pixel_weight = count / total_pixels
                h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
                h_deg = h * 360.0

                if s >= 0.16 and (v >= 0.12 or s >= 0.45):
                    vibrancy = (s**1.3) * (v**0.7)
                    for c_name, c_hue in TARGET_CENTERS.items():
                        dist = hue_distance(h_deg, c_hue)
                        match = math.exp(-0.5 * (dist / BANDWIDTH) ** 2)
                        scores[c_name] += pixel_weight * vibrancy * match

            max_c = max(scores, key=lambda k: scores[k])
            max_score = scores[max_c]

            if is_strictly_white and max_score < 0.05:
                return "white", ["white", "grey"]

            if is_strictly_dark_grey and max_score < 0.05:
                return "black", ["black", "grey"]

            matched = [max_c]
            for c_name, score in scores.items():
                if c_name != max_c and score >= max_score * 0.35 and score > 0.02:
                    matched.append(c_name)

            if is_strictly_white and max_score < 0.08:
                if "white" not in matched:
                    matched.append("white")
                if "grey" not in matched:
                    matched.append("grey")

            if is_strictly_dark_grey and max_score < 0.08:
                if "black" not in matched:
                    matched.append("black")
                if "grey" not in matched:
                    matched.append("grey")

            if (
                light_ratio > 0.35
                and "white" not in matched
                and (avg_sat < 0.35 or vibrant_ratio < 0.15)
            ):
                matched.append("white")

            if (
                dark_ratio > 0.35
                and "black" not in matched
                and (avg_sat < 0.35 or vibrant_ratio < 0.15)
            ):
                matched.append("black")

            if max_score >= 0.03:
                return max_c, matched
            elif is_strictly_white:
                return "white", matched
            else:
                return "black", matched
    except (OSError, ValueError, ZeroDivisionError):
        return "black", ["black", "grey"]


def process_file(filepath, is_video):
    ext = filepath.split(".")[-1].upper()
    info_str = ""
    thumb_path = (
        os.path.join(THUMBS_DIR, f"{os.path.basename(filepath)}.jpg")
        if is_video
        else filepath
    )

    # If already indexed and thumbnail exists (for videos), skip
    if filepath in properties and (
        not is_video or (os.path.exists(thumb_path) and os.path.getsize(thumb_path) > 0)
    ):
        return

    if is_video:
        w, h, fps = get_ffprobe_info(filepath)
        if w and h:
            info_str = f"{w}x{h}, {ext}, {fps} FPS" if fps else f"{w}x{h}, {ext}"
        else:
            info_str = f"{ext}"

        if not os.path.exists(thumb_path) or os.path.getsize(thumb_path) == 0:
            print(f"Generating thumbnail for: {os.path.basename(filepath)}")
            res = subprocess.run(
                [
                    "ffmpeg",
                    "-ss",
                    "00:00:00",
                    "-i",
                    filepath,
                    "-an",
                    "-vf",
                    "scale=384:-2",
                    "-vframes",
                    "1",
                    thumb_path,
                    "-y",
                    "-loglevel",
                    "error",
                ],
                check=False,
            )
            if (
                res.returncode != 0
                or not os.path.exists(thumb_path)
                or os.path.getsize(thumb_path) == 0
            ):
                subprocess.run(
                    [
                        "ffmpeg",
                        "-i",
                        filepath,
                        "-an",
                        "-vframes",
                        "1",
                        thumb_path,
                        "-y",
                        "-loglevel",
                        "error",
                    ],
                    check=False,
                )

        analyze_path = (
            thumb_path
            if (os.path.exists(thumb_path) and os.path.getsize(thumb_path) > 0)
            else None
        )
    else:
        w, h = get_image_info(filepath)
        if w and h:
            info_str = f"{w}x{h}, {ext}"
        else:
            info_str = f"{ext}"
        analyze_path = filepath

    primary_color, colors = ("grey", ["grey"])
    if analyze_path and os.path.exists(analyze_path):
        primary_color, colors = classify_colors_high_precision(analyze_path)

    properties[filepath] = {"info": info_str, "color": primary_color, "colors": colors}


VIDEO_EXTS = (".mp4", ".mkv", ".webm", ".avi", ".mov")
IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif")

scan_targets: list[tuple[str, bool, tuple[str, ...]]] = [
    (LIVE_WALLPAPERS_DIR, True, VIDEO_EXTS)
]
if INCLUDE_STATIC:
    scan_targets.append((WALLPAPERS_DIR, False, IMAGE_EXTS))

print(f"Scanning {'live wallpapers' if not INCLUDE_STATIC else 'all wallpapers'}...")
for base_dir, is_vid, exts in scan_targets:
    if os.path.exists(base_dir):
        for root, _, files in os.walk(base_dir):
            for f in files:
                if f.lower().endswith(exts):
                    process_file(os.path.join(root, f), is_vid)

with open(JSON_CACHE, "w") as f:
    json.dump(properties, f, indent=2)

print(f"Done! Processed {len(properties)} wallpapers.")
